{
  "name": "dsh-session-tag-manage",
  "version": "0.1.0",
  "description": "会话管理插件：会话标签自动分析 + Web UI 背景色渲染 + 每日 17:00 桌面提醒 + Web UI 手动标签更新",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-type-meta": "file:./stubs/dsh-type-meta",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": "./src/client/index.ts"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@deepseek-ai/dsh-cordis-utils"
      ]
    }
  }
}
